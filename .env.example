# Porta HTTP (hospedagens como Render/Railway injetam PORT sozinhas)
PORT=3000

# Arquivo do banco SQLite. Em produção, aponte para um disco persistente.
DB_PATH=./data/postbacks.db

# Opcional. Se definido, todo POST precisa do header
#   X-Signature: sha256=<HMAC-SHA256 hex do corpo cru usando este segredo>
# Se vazio, a verificação de assinatura fica desligada.
WEBHOOK_SECRET=

# Tamanho máximo do corpo do webhook
BODY_LIMIT=100kb
